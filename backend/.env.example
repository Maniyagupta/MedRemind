# Copy this file to .env and fill the values before starting the backend
# Example values shown for local development

# MongoDB connection string (required)
MONGODB_URI=mongodb://localhost:27017/medremind

# Backend port (optional)
PORT=5000

# JWT secret used to sign tokens (replace with a strong secret)
JWT_SECRET=replace_with_a_strong_secret

# Other optional settings
NODE_ENV=development
